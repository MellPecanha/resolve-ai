{
  "name": "backend",
  "type": "module",
  "version": "1.0.0",
  "description": "Backend for the Resolve Aí project",
  "author": "Mell Peçanha",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/prisma/seed.ts",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "8.0.0-rc.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.1"
  }
}
