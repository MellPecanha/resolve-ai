// use prisma-next

enum UserRole {
  SOLICITANTE
  GESTOR
}

enum OccurrenceStatus {
  ABERTA
  EM_ANALISE
  EM_ATENDIMENTO
  RESOLVIDA
  CANCELADA
}

enum OccurrencePriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model User {
  id                  Int      @id @default(autoincrement())
  name                String
  email               String   @unique
  password            String
  role                UserRole @default(SOLICITANTE)

  createdOccurrences  Occurrence[] @relation("RequesterOccurrences")
  assignedOccurrences Occurrence[] @relation("ResponsibleOccurrences")

  statusChanges OccurrenceStatusHistory[]

  comments Comment[]
  ratings  Rating[]

  createdAt            TimestamptzString @default(now())
  updatedAt            temporal.updatedAtString()
}

model Occurrence {
  id            Int                @id @default(autoincrement())
  title         String
  description   String
  category      String
  location      String
  imageUrl      String?
  status        OccurrenceStatus   @default(ABERTA)
  priority      OccurrencePriority @default(MEDIA)
  solution      String?

  requester     User  @relation("RequesterOccurrences", fields: [requesterId], references: [id])
  requesterId   Int

  responsible   User? @relation("ResponsibleOccurrences", fields: [responsibleId], references: [id])
  responsibleId Int?

  statusHistory OccurrenceStatusHistory[]

  comments Comment[]
  ratings  Rating?

  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model OccurrenceStatusHistory {
  id            Int              @id @default(autoincrement())

  occurrence    Occurrence       @relation(fields: [occurrenceId], references: [id])
  occurrenceId  Int

  previousStatus OccurrenceStatus
  newStatus      OccurrenceStatus

  changedBy     User             @relation(fields: [changedById], references: [id])
  changedById   Int

  observation   String?

  createdAt     TimestamptzString @default(now())
}

model Comment {
  id           Int         @id @default(autoincrement())
  content      String

  occurrence   Occurrence  @relation(fields: [occurrenceId], references: [id])
  occurrenceId Int

  author       User        @relation(fields: [authorId], references: [id])
  authorId     Int

  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model Rating {
  id           Int         @id @default(autoincrement())
  score        Int
  comment      String?

  occurrence   Occurrence  @relation(fields: [occurrenceId], references: [id])
  occurrenceId Int          @unique

  user         User        @relation(fields: [userId], references: [id])
  userId       Int

  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}